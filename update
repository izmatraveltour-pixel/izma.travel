<meta name="theme-color" content="#071b3a">
<style>
:root{
  --navy:#071b3a;--blue:#0b4ea2;--sky:#eaf5ff;--orange:#f39a24;--gold:#ffc45a;
  --ink:#10223d;--muted:#61728a;--white:#fff;--line:#dce7f3;
  --shadow:0 20px 60px rgba(7,27,58,.10)
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#f7fbff}
a{text-decoration:none;color:inherit}
button,input{font:inherit}
.top{background:var(--navy);color:#fff;font-size:13px;padding:9px 5vw;display:flex;justify-content:space-between;gap:20px}
.top span{opacity:.92}
.nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(18px);border-bottom:1px solid #dbe7f2;display:flex;align-items:center;justify-content:space-between;padding:9px 5vw;min-height:82px}
.brand{display:flex;align-items:center;min-width:170px}
.logo{height:70px;width:auto;max-width:180px;object-fit:contain;display:block}
.nav-center{display:flex;align-items:center;gap:28px;font-weight:750;font-size:14px}
.nav-center a{position:relative;padding:8px 0}
.nav-center a:after{content:"";position:absolute;left:0;right:100%;bottom:2px;height:2px;background:var(--orange);transition:.2s}
.nav-center a:hover{color:var(--blue)}
.nav-center a:hover:after{right:0}
.nav-actions{display:flex;align-items:center;gap:9px}
.social{width:39px;height:39px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line);background:#fff;color:var(--navy);transition:.2s}
.social:hover{transform:translateY(-2px);border-color:#bfd3e7;box-shadow:0 8px 20px rgba(7,27,58,.08)}
.social svg{width:18px;height:18px;fill:currentColor}
.cta{background:var(--orange);color:#111;padding:12px 18px;border-radius:999px;font-weight:850;box-shadow:0 8px 24px rgba(243,154,36,.25);white-space:nowrap}
.menu-btn{display:none;width:44px;height:44px;border:1px solid var(--line);border-radius:12px;background:#fff;cursor:pointer;align-items:center;justify-content:center;font-size:22px}
.mobile-menu{display:none;background:#fff;border-bottom:1px solid var(--line);padding:12px 5vw 18px}
.mobile-menu.open{display:grid;gap:8px}
.mobile-menu a{padding:12px 8px;border-radius:10px;font-weight:750}
.mobile-menu a:hover{background:var(--sky)}

.hero{min-height:680px;position:relative;overflow:hidden;background:radial-gradient(circle at 78% 18%,#7ec6ff 0,#bfe5ff 18%,transparent 38%),linear-gradient(120deg,#061938 0%,#0a3876 48%,#0e6dbb 100%);color:white}
.hero:after{content:"";position:absolute;inset:auto -5% -180px;height:300px;background:#f7fbff;border-radius:50% 50% 0 0/100% 100% 0 0;transform:rotate(-2deg)}
.hero-inner{position:relative;z-index:2;max-width:1250px;margin:auto;padding:82px 5vw 160px;display:grid;grid-template-columns:1.05fr .95fr;gap:50px;align-items:center}
.eyebrow{display:inline-flex;gap:9px;align-items:center;background:#ffffff18;border:1px solid #ffffff2e;border-radius:999px;padding:9px 14px;font-weight:750;font-size:13px;letter-spacing:.4px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--gold);box-shadow:0 0 16px var(--gold)}
h1{font-size:clamp(44px,6vw,78px);line-height:.98;margin:24px 0 20px;letter-spacing:-3px}
h1 em{font-style:normal;color:#ffc45a}
.hero p{font-size:19px;line-height:1.7;color:#dcecff;max-width:650px}
.actions{display:flex;gap:14px;margin:30px 0;flex-wrap:wrap}
.btn{padding:15px 22px;border-radius:12px;font-weight:850;border:1px solid #ffffff35}
.btn.primary{background:var(--orange);color:#111;border:0}
.btn.ghost{background:#ffffff12}
.trust{display:flex;gap:25px;flex-wrap:wrap;margin-top:25px;color:#d9e8fa;font-size:13px}
.trust b{display:block;color:#fff;font-size:17px}
.plane-wrap{position:relative;height:390px}
.plane{position:absolute;right:2%;top:50%;transform:translateY(-50%) rotate(-8deg);font-size:190px;filter:drop-shadow(0 35px 28px #00132e66)}
.orb{position:absolute;border-radius:50%;filter:blur(1px);opacity:.7}
.o1{width:210px;height:210px;background:#ffffff14;right:80px;top:40px}
.o2{width:80px;height:80px;background:#ffc45a33;right:10px;bottom:50px}

.search-card{max-width:1120px;margin:-70px auto 0;position:relative;z-index:8;background:white;border-radius:24px;box-shadow:var(--shadow);padding:24px;border:1px solid #e4edf6}
.tabs{display:flex;gap:8px;border-bottom:1px solid var(--line);padding-bottom:15px;margin-bottom:18px;overflow:auto}
.tab{border:0;background:transparent;padding:11px 15px;border-radius:10px;font-weight:850;color:var(--muted);cursor:pointer;white-space:nowrap}
.tab.active{background:#eaf4ff;color:var(--blue)}
.fields{display:grid;grid-template-columns:1.2fr 1.2fr 1fr 1fr auto;gap:12px}
.field{border:1px solid var(--line);border-radius:13px;padding:11px 13px;background:#fbfdff}
.field small{display:block;color:var(--muted);font-weight:750;margin-bottom:5px}
.field input{border:0;outline:0;background:transparent;width:100%;font-weight:750;color:var(--ink)}
.searchbtn{border:0;border-radius:13px;background:var(--navy);color:#fff;font-weight:850;padding:0 22px;cursor:pointer;min-height:54px}
.searchbtn:hover{background:#0b2b59}

.section{max-width:1180px;margin:100px auto;padding:0 5vw}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:35px}
.section h2{font-size:42px;letter-spacing:-1.5px;margin:0}
.lead{color:var(--muted);max-width:600px;line-height:1.7}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.card{background:white;border:1px solid var(--line);border-radius:20px;padding:25px;box-shadow:0 10px 35px rgba(7,27,58,.04);transition:.25s}
.card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.icon{width:48px;height:48px;border-radius:14px;background:#eaf4ff;color:var(--blue);display:grid;place-items:center;font-size:23px;margin-bottom:20px}
.card h3{margin:0 0 9px}
.card p{color:var(--muted);line-height:1.6;font-size:14px}
.feature{background:var(--navy);color:#fff;border-radius:30px;padding:60px;display:grid;grid-template-columns:1fr 1fr;gap:60px;overflow:hidden;position:relative}
.feature:before{content:"";position:absolute;width:500px;height:500px;border-radius:50%;background:#0d5aa71c;right:-180px;top:-160px}
.feature h2{font-size:45px;margin:0 0 18px;letter-spacing:-1px}
.feature p{color:#bfd0e5;line-height:1.75}
.points{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:25px}
.point{border:1px solid #ffffff1f;background:#ffffff0a;padding:17px;border-radius:14px}
.point b{display:block;margin-bottom:5px}
.point span{font-size:13px;color:#b9cbe1}
.quote{background:linear-gradient(135deg,#fff,#edf7ff);border:1px solid var(--line);border-radius:24px;padding:35px}
.quote p{font-size:21px;line-height:1.55;font-weight:750}
.quote small{color:var(--muted)}
.destinations{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.destination{min-height:230px;border-radius:22px;padding:25px;display:flex;flex-direction:column;justify-content:end;color:#fff;overflow:hidden;position:relative;background:linear-gradient(135deg,#0b4ea2,#0a2348)}
.destination:nth-child(2){background:linear-gradient(135deg,#1165aa,#173d70)}
.destination:nth-child(3){background:linear-gradient(135deg,#d57a18,#7e3d09)}
.destination:before{content:"✈";position:absolute;right:25px;top:22px;font-size:50px;opacity:.16;transform:rotate(-20deg)}
.destination h3{font-size:26px;margin:0 0 5px}
.destination span{opacity:.85}

.footer{background:#04142d;color:#b9c9dc;padding:55px 5vw 25px}
.footer-inner{max-width:1180px;margin:auto;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:35px}
.footer img{height:72px;max-width:190px;object-fit:contain;background:white;border-radius:12px;padding:7px;margin-bottom:15px}
.footer h4{color:white;margin:0 0 15px}
.footer a,.footer p{display:block;font-size:14px;line-height:1.9;margin:4px 0}
.footer-social{display:flex;gap:9px;margin-top:16px}
.footer-social .social{background:#0b244b;color:#fff;border-color:#17355d}
.copy{max-width:1180px;margin:35px auto 0;border-top:1px solid #ffffff17;padding-top:18px;font-size:12px}

.floating-wa{position:fixed;right:20px;bottom:20px;z-index:60;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:#25D366;color:#fff;box-shadow:0 12px 35px rgba(0,0,0,.2)}
.floating-wa svg{width:29px;height:29px;fill:currentColor}

@media(max-width:980px){
  .nav-center{display:none}
  .nav-actions .social{display:none}
  .menu-btn{display:flex}
  .hero-inner{grid-template-columns:1fr;padding-top:55px}
  .plane-wrap{height:220px}
  .plane{font-size:130px;right:10%}
  .fields{grid-template-columns:1fr 1fr}
  .searchbtn{height:52px}
  .cards{grid-template-columns:1fr 1fr}
  .feature{grid-template-columns:1fr;padding:35px}
  .destinations{grid-template-columns:1fr}
  .footer-inner{grid-template-columns:1fr 1fr}
