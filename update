@media(max-width:560px){
  .top{display:none}
  .nav{padding:8px 4vw;min-height:70px}
  .logo{height:56px;max-width:150px}
  .nav-actions .cta{display:none}
  .hero-inner{padding:45px 5vw 120px}
  .hero p{font-size:16px}
  .search-card{margin:-45px 4vw 0;padding:16px}
  .fields{grid-template-columns:1fr}
  .section{margin:70px auto}
  .section h2{font-size:32px}
  .cards{grid-template-columns:1fr}
  .points{grid-template-columns:1fr}
  .footer-inner{grid-template-columns:1fr}
  h1{letter-spacing:-2px}
  .feature h2{font-size:34px}
  .floating-wa{right:14px;bottom:14px}
}
</style>
</head>
